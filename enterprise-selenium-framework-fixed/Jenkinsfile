pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    environment {
        PROJECT_DIR = 'enterprise-selenium-framework-fixed'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo 'Cloning repository...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir("${PROJECT_DIR}") {
                    bat 'mvn clean install -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${PROJECT_DIR}") {
                    bat 'mvn clean test'
                }
            }
        }

        stage('Parallel Cross Browser Test') {
            parallel {
                stage('Chrome Tests') {
                    steps {
                        dir("${PROJECT_DIR}") {
                            bat 'mvn test -Dbrowser=chrome'
                        }
                    }
                }
                stage('Edge Tests') {
                    steps {
                        dir("${PROJECT_DIR}") {
                            bat 'mvn test -Dbrowser=edge'
                        }
                    }
                }
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: "${PROJECT_DIR}/target/**/*.html", fingerprint: true
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
            }
        }
    }

    post {

        always {
            echo 'Publishing test results...'

            junit "${PROJECT_DIR}/target/surefire-reports/*.xml"

            archiveArtifacts artifacts: "${PROJECT_DIR}/target/screenshots/*.png", allowEmptyArchive: true
        }

        success {
            echo 'Build SUCCESSFUL 🎉'
        }

        unstable {
            echo 'Build UNSTABLE - Some tests failed ⚠️'
        }

        failure {
            echo 'Build FAILED ❌'
        }
    }
}
