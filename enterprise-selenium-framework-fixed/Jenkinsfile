pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    stages {

        stage('Build') {
            steps {
                dir('enterprise-selenium-framework-fixed') {
                    bat 'mvn clean install -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('enterprise-selenium-framework-fixed') {
                    bat 'mvn clean test'
                }
            }
        }

        stage('Deploy') {
            steps {
                bat 'echo Deploying application...'
            }
        }

    }
    stage('Parallel Tests') {
    parallel {
        stage('Chrome') {
            steps {
                bat 'mvn test -Dbrowser=chrome'
            }
        }
        stage('Edge') {
            steps {
                bat 'mvn test -Dbrowser=edge'
            }
        }
    }
}
    post {
    always {
        junit 'enterprise-selenium-framework-fixed/target/surefire-reports/*.xml'
    }
}
}
